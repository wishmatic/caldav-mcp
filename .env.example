# Server (optional)

HOST=0.0.0.0
PORT=8080

LOG_LEVEL=info # debug, info, warn, error, dpanic, panic, fatal

# Auth

# Required. Every /mcp request must carry it as "Authorization: Bearer <API_KEY>".

API_KEY=change-me

# Fetch these CalDAV servers, as name=url,name=url. Credentials go in the URL.
CALDAV_SERVERS=personal=https://user:password@cal.example.com/dav

# Where the event cache lives, how often to fetch it, and how far ahead.
CACHE_PATH=./caldav.db
SYNC_INTERVAL_SECONDS=3600
SYNC_LOOKAHEAD_DAYS=60
